# Smart Farmer Backend - Environment Variables
# Copy this to .env and fill in your values

PORT=5001
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/smart-farmer?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-here
NODE_ENV=production
FRONTEND_URL=https://farmer-assistance-system-beta.vercel.app

# Email (for OTP/notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cloudinary (optional - for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OpenWeather (optional)
OPENWEATHER_API_KEY=
